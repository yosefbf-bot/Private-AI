# OpenAI API Key (optional, can also be configured in the UI Settings)
OPENAI_API_KEY=

# Gemini API Key (for server-side AI integrations)
GEMINI_API_KEY=


# Required local development authentication; generate outside source control
PRIVATE_AI_DEV_TOKEN=
# Optional absolute data directory outside the repository
PRIVATE_AI_DEV_DATA=


# Optional exact HTTPS preview origin; never use a wildcard.
PRIVATE_AI_DEV_PREVIEW_ORIGIN=
